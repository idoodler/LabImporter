<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect Medical Records: lab results are written/read as FHIR Observations. -->
    <uses-permission android:name="android.permission.health.WRITE_MEDICAL_DATA" />
    <uses-permission android:name="android.permission.health.READ_MEDICAL_DATA_LABORATORY_RESULTS" />

    <!-- INTERNET exists for one thing only: on phones without Gemini Nano for apps, the
         download of the pinned Gemma model file the user asked for (ai/gemma/GemmaModel.URL,
         fetched by the system download manager in ai/gemma/ModelDownloads.kt). Lab data never
         leaves the device; NetworkGuardrailTest fails the build if other code reaches for the
         network. (Gemini Nano downloads/updates are handled by the system's AICore.) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "AI model ready" / "not downloaded" while LabImporter isn't on screen; asked for when the
         user starts the download. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".LabImporterApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LabImporter"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LabImporter.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with LabImporter" for PDFs and images, like the iOS document types. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Share report text from any app (portal, e-mail) straight into the import flow. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Launcher shortcuts: Scan (static) and one per tracked value (dynamic). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- Health Connect permission rationale (required to request health permissions). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: rationale entry point for Health Connect permissions. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Gemma on the GPU: the vendor's OpenCL driver (optional; LiteRT-LM falls back to the CPU). -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <!-- ML Kit's bundled text recognition logs usage statistics through Google's Clearcut
             backend once the app may use the network. Without its backend, those logs are
             dropped on the device: the model download stays the app's only network traffic. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- The model download finished (also while the app is closed): check and install it. -->
        <receiver
            android:name=".ai.gemma.ModelDownloadReceiver"
            android:exported="true"
            android:permission="android.permission.SEND_DOWNLOAD_COMPLETED_INTENTS">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
        <service
            android:name=".ai.gemma.ModelInstallJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
