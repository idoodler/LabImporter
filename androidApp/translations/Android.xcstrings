        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitsakten in Health Connect sind auf diesem Gerät nicht verfügbar. Deine Berichte werden daher privat in LabImporter auf diesem Gerät gespeichert. Du kannst das später in den Einstellungen ändern."
          }
        },
        "el" : {
          "stringUnit" : {
