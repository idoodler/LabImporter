    "Otherwise the download waits for Wi-Fi. Mobile data may cost extra." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иначе изтеглянето изчаква Wi-Fi. Мобилните данни може да струват допълнително."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no, la baixada espera una xarxa Wi-Fi. Les dades mòbils poden tenir un cost addicional."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jinak stahování počká na Wi-Fi. Mobilní data mohou být zpoplatněna."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellers venter downloaden på Wi-Fi. Mobildata kan koste ekstra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonst wartet der Download auf WLAN. Mobile Daten können zusätzlich kosten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαφορετικά, η λήψη περιμένει Wi-Fi. Τα δεδομένα κινητής μπορεί να έχουν επιπλέον κόστος."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no, la descarga espera a una red Wi-Fi. Los datos móviles pueden tener un coste adicional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muuten lataus odottaa Wi-Fi-yhteyttä. Mobiilidata voi maksaa lisää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinon, le téléchargement attend le Wi-Fi. Les données mobiles peuvent être facturées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inače preuzimanje čeka Wi-Fi. Mobilni podaci mogu se dodatno naplatiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellenkező esetben a letöltés Wi-Fi-re vár. A mobiladat-forgalom többletköltséggel járhat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altrimenti il download attende il Wi-Fi. I dati mobili potrebbero avere costi aggiuntivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可しない場合、ダウンロードはWi-Fi接続まで待機します。モバイルデータには追加料金がかかる場合があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anders wacht de download op wifi. Mobiele data kan extra kosten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przeciwnym razie pobieranie zaczeka na Wi-Fi. Dane mobilne mogą wiązać się z dodatkowymi opłatami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caso contrário, o download aguarda o Wi-Fi. Os dados móveis podem gerar custos extras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caso contrário, a transferência aguarda o Wi-Fi. Os dados móveis podem ter custos adicionais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altfel, descărcarea așteaptă Wi-Fi. Datele mobile pot implica costuri suplimentare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Иначе загрузка дождётся Wi-Fi. Мобильные данные могут оплачиваться дополнительно."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inak sťahovanie počká na Wi-Fi. Mobilné dáta môžu byť spoplatnené."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annars väntar hämtningen på Wi-Fi. Mobildata kan kosta extra."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksi takdirde indirme Wi-Fi'yi bekler. Mobil veri ek ücrete tabi olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
