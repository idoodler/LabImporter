            "value" : "Berichte werden als FHIR-Laborergebnisse in Health Connect gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αναφορές αποθηκεύονται στο Health Connect ως εργαστηριακά αποτελέσματα FHIR."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
