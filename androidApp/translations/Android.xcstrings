    "Reports are saved to Health Connect as FHIR lab results." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отчетите се запазват в Health Connect като лабораторни резултати във формат FHIR."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els informes es desen a Health Connect com a resultats de laboratori FHIR."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokoly se ukládají do Health Connect jako laboratorní výsledky FHIR."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporter gemmes i Health Connect som FHIR-laboratorieresultater."
          }
        },
        "de" : {
          "stringUnit" : {
