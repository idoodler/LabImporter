    "Scan or import your lab report and save it directly to Health Connect." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирайте или импортирайте лабораторния си отчет и го запазете директно в Health Connect."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneja o importa el teu informe de laboratori i desa'l directament a Health Connect."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte nebo importujte svůj laboratorní protokol a uložte jej přímo do Health Connect."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan eller importér din laboratorierapport, og gem den direkte i Health Connect."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne oder importiere deinen Laborbefund und speichere ihn direkt in Health Connect."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε ή εισαγάγετε την εργαστηριακή σας αναφορά και αποθηκεύστε την απευθείας στο Health Connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea o importa tu informe de laboratorio y guárdalo directamente en Health Connect."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaa tai tuo laboratorioraporttisi ja tallenna se suoraan Health Connectiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numérisez ou importez votre compte rendu de laboratoire et enregistrez-le directement dans Health Connect."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenirajte ili uvezite svoj laboratorijski nalaz i spremite ga izravno u Health Connect."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szkenneld be vagy importáld a laborleletedet, és mentsd közvetlenül a Health Connectbe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona o importa il tuo referto di laboratorio e salvalo direttamente in Health Connect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検査報告書をスキャンまたは読み込んで、ヘルスコネクトに直接保存できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan of importeer je laboratoriumrapport en bewaar het direct in Health Connect."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeskanuj lub zaimportuj wynik badań i zapisz go bezpośrednio w Health Connect."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitalize ou importe seu laudo laboratorial e salve-o diretamente no Health Connect."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitalize ou importe o seu relatório laboratorial e guarde-o diretamente no Health Connect."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanează sau importă raportul de laborator și salvează-l direct în Health Connect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсканируйте или импортируйте лабораторный отчёт и сохраните его прямо в Health Connect."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte alebo importujte svoju laboratórnu správu a uložte ju priamo do Health Connect."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna eller importera din labbrapport och spara den direkt i Health Connect."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laboratuvar raporunuzu tarayın veya içe aktarın ve doğrudan Health Connect'e kaydedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відскануйте або імпортуйте лабораторний звіт і збережіть його просто в Health Connect."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描或导入你的化验报告，并直接保存到 Health Connect。"
          }
        }
      }
    },
    "Scan, photograph, paste or open any lab report." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканирайте, снимайте, поставете или отворете всеки лабораторен отчет."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneja, fotografia, enganxa o obre qualsevol informe de laboratori."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte, vyfoťte, vložte nebo otevřete jakýkoli laboratorní protokol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan, fotografér, indsæt eller åbn enhver laboratorierapport."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne, fotografiere, füge ein oder öffne jeden Laborbefund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε, φωτογραφίστε, επικολλήστε ή ανοίξτε οποιαδήποτε εργαστηριακή αναφορά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea, fotografía, pega o abre cualquier informe de laboratorio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannaa, kuvaa, liitä tai avaa mikä tahansa laboratorioraportti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numérisez, photographiez, collez ou ouvrez n’importe quel compte rendu de laboratoire."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenirajte, fotografirajte, zalijepite ili otvorite bilo koji laboratorijski nalaz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szkennelj, fényképezz, illessz be vagy nyiss meg bármilyen laborleletet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona, fotografa, incolla o apri qualsiasi referto di laboratorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あらゆる検査報告書をスキャン、撮影、貼り付け、または開くことができます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan, fotografeer, plak of open elk laboratoriumrapport."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanuj, fotografuj, wklejaj lub otwieraj dowolne wyniki badań."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitalize, fotografe, cole ou abra qualquer laudo laboratorial."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitalize, fotografe, cole ou abra qualquer relatório laboratorial."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanează, fotografiază, lipește sau deschide orice raport de laborator."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сканируйте, фотографируйте, вставляйте или открывайте любые лабораторные отчёты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenujte, odfoťte, vložte alebo otvorte akúkoľvek laboratórnu správu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skanna, fotografera, klistra in eller öppna valfri labbrapport."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir laboratuvar raporunu tarayın, fotoğraflayın, yapıştırın veya açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скануйте, фотографуйте, вставляйте або відкривайте будь-який лабораторний звіт."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描、拍摄、粘贴或打开任何化验报告。"
          }
        }
      }
    },
    "Values are extracted by on-device AI and matched to LOINC codes." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стойностите се извличат от ИИ на устройството и се съпоставят с LOINC кодове."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA del dispositiu n'extreu els valors i els associa a codis LOINC."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnoty extrahuje AI na zařízení a přiřadí je ke kódům LOINC."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værdierne udtrækkes af AI'en på enheden og matches med LOINC-koder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Werte werden von der geräteinternen KI erkannt und LOINC-Codes zugeordnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμές εξάγονται από την ΤΝ στη συσκευή και αντιστοιχίζονται σε κωδικούς LOINC."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA en el dispositivo extrae los valores y los asocia a códigos LOINC."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteella toimiva tekoäly poimii arvot ja yhdistää ne LOINC-koodeihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs sont extraites par l’IA sur l’appareil et associées à des codes LOINC."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrijednosti izdvaja umjetna inteligencija na uređaju i povezuje ih s LOINC kodovima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az értékeket az eszközön futó MI olvassa ki, és LOINC-kódokhoz rendeli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori vengono estratti dall’IA sul dispositivo e associati ai codici LOINC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値はデバイス上のAIによって抽出され、LOINCコードに照合されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarden worden door de AI op het apparaat uitgelezen en aan LOINC-codes gekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartości są odczytywane przez sztuczną inteligencję na urządzeniu i dopasowywane do kodów LOINC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores são extraídos pela IA no dispositivo e associados a códigos LOINC."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores são extraídos pela IA no dispositivo e associados a códigos LOINC."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valorile sunt extrase de IA de pe dispozitiv și asociate cu coduri LOINC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значения извлекаются ИИ на устройстве и сопоставляются с кодами LOINC."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hodnoty extrahuje AI v zariadení a priradí ich ku kódom LOINC."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Värdena läses ut av AI:n på enheten och matchas mot LOINC-koder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değerler cihaz üzerindeki yapay zeka tarafından çıkarılır ve LOINC kodlarıyla eşleştirilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значення витягує штучний інтелект на пристрої та зіставляє їх із кодами LOINC."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数值由设备端 AI 提取，并与 LOINC 代码匹配。"
          }
        }
      }
    },
    "Save your reports to Health Connect so they live with the rest of your health data. Lab results are stored as standard FHIR records on this device." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазвайте отчетите си в Health Connect, за да са заедно с останалите ви здравни данни. Лабораторните резултати се съхраняват като стандартни FHIR записи на това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desa els teus informes a Health Connect perquè estiguin amb la resta de les teves dades de salut. Els resultats de laboratori es guarden com a registres FHIR estàndard en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládejte protokoly do Health Connect, aby byly spolu s ostatními zdravotními údaji. Laboratorní výsledky se ukládají jako standardní záznamy FHIR v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem dine rapporter i Health Connect, så de er samlet med resten af dine helbredsdata. Laboratorieresultater gemmes som standard-FHIR-poster på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere deine Berichte in Health Connect, damit sie bei deinen übrigen Gesundheitsdaten liegen. Laborergebnisse werden als standardisierte FHIR-Einträge auf diesem Gerät gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε τις αναφορές σας στο Health Connect για να βρίσκονται μαζί με τα υπόλοιπα δεδομένα υγείας σας. Τα εργαστηριακά αποτελέσματα αποθηκεύονται ως τυπικές εγγραφές FHIR σε αυτήν τη συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus informes en Health Connect para tenerlos junto al resto de tus datos de salud. Los resultados de laboratorio se almacenan como registros FHIR estándar en este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna raporttisi Health Connectiin, jotta ne ovat muiden terveystietojesi kanssa. Laboratoriotulokset tallennetaan tähän laitteeseen standardinmukaisina FHIR-tietueina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez vos rapports dans Health Connect pour les garder avec le reste de vos données de santé. Les résultats de laboratoire sont stockés sous forme d’enregistrements FHIR standard sur cet appareil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremite izvješća u Health Connect kako bi bila uz ostale vaše zdravstvene podatke. Laboratorijski rezultati pohranjuju se kao standardni FHIR zapisi na ovom uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentsd a jelentéseidet a Health Connectbe, hogy a többi egészségügyi adatod mellett legyenek. A laboreredmények szabványos FHIR-rekordokként tárolódnak ezen az eszközön."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva i tuoi referti in Health Connect per tenerli insieme al resto dei tuoi dati sanitari. I risultati di laboratorio vengono archiviati come record FHIR standard su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートをヘルスコネクトに保存すると、ほかの健康データと一緒に管理できます。検査結果は標準のFHIRレコードとしてこのデバイスに保存されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar je rapporten in Health Connect, zodat ze bij de rest van je gezondheidsgegevens staan. Labuitslagen worden als standaard FHIR-records op dit apparaat opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj raporty w Health Connect, aby były razem z pozostałymi danymi o zdrowiu. Wyniki badań są przechowywane na tym urządzeniu jako standardowe rekordy FHIR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve seus relatórios no Health Connect para que fiquem junto com o restante dos seus dados de saúde. Os resultados laboratoriais são armazenados como registros FHIR padrão neste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde os seus relatórios no Health Connect para que fiquem junto do resto dos seus dados de saúde. Os resultados laboratoriais são armazenados como registos FHIR padrão neste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvează rapoartele în Health Connect ca să stea alături de restul datelor tale de sănătate. Rezultatele de laborator sunt stocate ca înregistrări FHIR standard pe acest dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняйте отчёты в Health Connect, чтобы они хранились вместе с остальными данными о здоровье. Результаты анализов сохраняются на этом устройстве как стандартные записи FHIR."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukladajte správy do Health Connect, aby boli spolu s ostatnými zdravotnými údajmi. Laboratórne výsledky sa ukladajú ako štandardné záznamy FHIR v tomto zariadení."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara dina rapporter i Health Connect så att de finns tillsammans med resten av dina hälsodata. Labbresultat lagras som standardiserade FHIR-poster på den här enheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raporlarınızı Health Connect'e kaydedin; böylece diğer sağlık verilerinizle birlikte dururlar. Laboratuvar sonuçları bu cihazda standart FHIR kayıtları olarak saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте звіти в Health Connect, щоб вони були разом з іншими даними про здоров'я. Результати аналізів зберігаються на цьому пристрої як стандартні записи FHIR."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将报告保存到 Health Connect，与你的其他健康数据放在一起。化验结果会以标准 FHIR 记录的形式存储在此设备上。"
          }
        }
      }
    },
