        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A LabImporternek az Android eszközön futó MI-jének újabb verziójára van szüksége. Frissítsd az eszközt, majd ellenőrizd újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
