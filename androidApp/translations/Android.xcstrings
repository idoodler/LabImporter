    "This frees %1$@. LabImporter can't read reports on this phone until you download it again." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Така се освобождават %1$@. LabImporter няма да може да чете отчети на този телефон, докато не го изтеглите отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això allibera %1$@. LabImporter no podrà llegir informes en aquest telèfon fins que el tornis a baixar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvolní se tím %1$@. LabImporter nebude moci v tomto telefonu číst protokoly, dokud model znovu nestáhnete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det frigør %1$@. LabImporter kan ikke læse rapporter på denne telefon, før du downloader den igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden %1$@ frei. LabImporter kann auf diesem Telefon keine Berichte lesen, bis du es erneut lädst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έτσι ελευθερώνονται %1$@. Το LabImporter δεν θα μπορεί να διαβάζει αναφορές σε αυτό το τηλέφωνο μέχρι να το κατεβάσετε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así se liberan %1$@. LabImporter no podrá leer informes en este teléfono hasta que lo vuelvas a descargar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä vapauttaa %1$@. LabImporter ei voi lukea raportteja tällä puhelimella, ennen kuin lataat mallin uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela libère %1$@. LabImporter ne pourra plus lire de rapports sur ce téléphone tant que vous ne l’aurez pas retéléchargé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time se oslobađa %1$@. LabImporter neće moći čitati izvješća na ovom telefonu dok ga ponovno ne preuzmete."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezzel %1$@ szabadul fel. A LabImporter nem tud jelentéseket beolvasni ezen a telefonon, amíg újra le nem töltöd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questo modo liberi %1$@. LabImporter non potrà leggere referti su questo telefono finché non lo scaricherai di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の空き容量が確保されます。もう一度ダウンロードするまで、LabImporterはこのスマートフォンでレポートを読み取れなくなります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit maakt %1$@ vrij. LabImporter kan op deze telefoon geen rapporten lezen totdat je het opnieuw downloadt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwolni to %1$@. LabImporter nie będzie mógł odczytywać raportów na tym telefonie, dopóki nie pobierzesz modelu ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso libera %1$@. O LabImporter não poderá ler relatórios neste celular até você baixá-lo novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto liberta %1$@. O LabImporter não poderá ler relatórios neste telemóvel até o transferir novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astfel se eliberează %1$@. LabImporter nu va putea citi rapoarte pe acest telefon până nu îl descarci din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освободится %1$@. LabImporter не сможет читать отчёты на этом телефоне, пока вы не скачаете модель снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvoľní sa tým %1$@. LabImporter nebude môcť v tomto telefóne čítať správy, kým model znova nestiahnete."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det frigör %1$@. LabImporter kan inte läsa rapporter på den här telefonen förrän du hämtar den igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem %1$@ yer açar. Modeli yeniden indirene kadar LabImporter bu telefonda rapor okuyamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Так звільниться %1$@. LabImporter не зможе читати звіти на цьому телефоні, доки ви не завантажите модель знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将释放 %1$@。在你再次下载之前，LabImporter 将无法在此手机上读取报告。"
          }
        }
      }
    },
