    "The downloaded AI model couldn't be loaded on this phone. Try again, or delete it in Settings to free up the space." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтегленият модел на ИИ не можа да се зареди на този телефон. Опитайте отново или го изтрийте в Настройки, за да освободите място."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut carregar el model d'IA baixat en aquest telèfon. Torna-ho a provar o elimina'l a Ajustaments per alliberar l'espai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stažený model AI se v tomto telefonu nepodařilo načíst. Zkuste to znovu, nebo ho smažte v Nastavení a uvolněte tak místo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den downloadede AI-model kunne ikke indlæses på denne telefon. Prøv igen, eller slet den i Indstillinger for at frigøre pladsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das heruntergeladene KI-Modell konnte auf diesem Telefon nicht geladen werden. Versuche es erneut oder lösche es in den Einstellungen, um den Speicherplatz freizugeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση του μοντέλου ΤΝ που λήφθηκε σε αυτό το τηλέφωνο. Δοκιμάστε ξανά ή διαγράψτε το στις Ρυθμίσεις για να ελευθερώσετε χώρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cargar en este teléfono el modelo de IA descargado. Inténtalo de nuevo o elimínalo en Ajustes para liberar espacio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladattua tekoälymallia ei voitu käynnistää tässä puhelimessa. Yritä uudelleen tai poista se Asetuksista, jotta tilaa vapautuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger sur ce téléphone le modèle d’IA téléchargé. Réessayez ou supprimez-le dans les Réglages pour libérer de l’espace."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzeti model umjetne inteligencije nije moguće učitati na ovom telefonu. Pokušajte ponovno ili ga izbrišite u Postavkama kako biste oslobodili prostor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A letöltött MI-modellt nem sikerült betölteni ezen a telefonon. Próbáld újra, vagy töröld a Beállításokban, hogy felszabadítsd a helyet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare su questo telefono il modello di IA scaricato. Riprova o eliminalo in Impostazioni per liberare spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたAIモデルをこのスマートフォンで読み込めませんでした。もう一度お試しいただくか、設定で削除して空き容量を確保してください。"
