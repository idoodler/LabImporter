    "Downloads once, in the background — also while you use other apps — and stays on this phone. Needs %1$@ of free storage." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтегля се еднократно във фонов режим — и докато използвате други приложения — и остава на този телефон. Нужни са %1$@ свободно място."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es baixa una sola vegada en segon pla, també mentre fas servir altres apps, i es conserva en aquest telèfon. Calen %1$@ d'espai lliure."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stáhne se jednou na pozadí — i když používáte jiné aplikace — a zůstane v tomto telefonu. Potřebuje %1$@ volného místa."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloades én gang i baggrunden – også mens du bruger andre apps – og gemmes på denne telefon. Kræver %1$@ ledig lagerplads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird einmalig im Hintergrund geladen – auch während du andere Apps nutzt – und bleibt auf diesem Telefon. Benötigt %1$@ freien Speicherplatz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γίνεται λήψη μία φορά στο παρασκήνιο — και ενώ χρησιμοποιείτε άλλες εφαρμογές — και παραμένει σε αυτό το τηλέφωνο. Απαιτεί %1$@ ελεύθερο χώρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descarga una sola vez en segundo plano, también mientras usas otras apps, y se guarda en este teléfono. Necesita %1$@ de espacio libre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ladataan kerran taustalla – myös kun käytät muita sovelluksia – ja säilytetään tässä puhelimessa. Vaatii %1$@ vapaata tallennustilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargé une seule fois en arrière-plan — même pendant que vous utilisez d’autres apps — et conservé sur ce téléphone. Nécessite %1$@ d’espace libre."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzima se jednom u pozadini — i dok koristite druge aplikacije — i ostaje na ovom telefonu. Potrebno je %1$@ slobodnog prostora."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszer, a háttérben töltődik le – akkor is, ha más alkalmazásokat használsz –, és ezen a telefonon marad. %1$@ szabad tárhelyre van szükség."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaricato una sola volta in background, anche mentre usi altre app, e conservato su questo telefono. Richiede %1$@ di spazio libero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドで一度だけダウンロードされ（ほかのアプリを使っている間も続きます）、このスマートフォンに保存されます。%1$@の空き容量が必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt eenmalig op de achtergrond gedownload – ook terwijl je andere apps gebruikt – en blijft op deze telefoon. Vereist %1$@ vrije opslagruimte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierany jednorazowo w tle — także gdy korzystasz z innych aplikacji — i przechowywany na tym telefonie. Wymaga %1$@ wolnego miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixado uma única vez em segundo plano — também enquanto você usa outros apps — e mantido neste celular. Requer %1$@ de espaço livre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transferido uma única vez em segundo plano — também enquanto usa outras apps — e mantido neste telemóvel. Requer %1$@ de espaço livre."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descarcă o singură dată în fundal — și cât folosești alte aplicații — și rămâne pe acest telefon. Necesită %1$@ de spațiu liber."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачивается один раз в фоновом режиме — даже пока вы пользуетесь другими приложениями — и хранится на этом телефоне. Требуется %1$@ свободного места."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiahne sa raz na pozadí — aj keď používate iné aplikácie — a zostane v tomto telefóne. Potrebuje %1$@ voľného miesta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hämtas en gång i bakgrunden – även medan du använder andra appar – och sparas på den här telefonen. Kräver %1$@ ledigt lagringsutrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka planda bir kez indirilir (siz başka uygulamaları kullanırken de) ve bu telefonda saklanır. %1$@ boş depolama alanı gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажується один раз у фоновому режимі — навіть поки ви користуєтеся іншими застосунками — і зберігається на цьому телефоні. Потрібно %1$@ вільного місця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在后台下载一次（使用其他 App 时也会继续），并保存在此手机上。需要 %1$@ 的可用存储空间。"
          }
        }
      }
    },
