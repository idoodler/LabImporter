    "LabImporter needs Gemini Nano, Android's on-device AI, to read your lab reports privately on your device." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter се нуждае от Gemini Nano – ИИ на устройството в Android, – за да чете лабораторните ви отчети поверително на устройството ви."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El LabImporter necessita el Gemini Nano, la IA del dispositiu d'Android, per llegir els teus informes de laboratori de manera privada al teu dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter potřebuje Gemini Nano, AI na zařízení od Androidu, aby mohl soukromě číst vaše laboratorní protokoly přímo ve vašem zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter skal bruge Gemini Nano, Androids AI på enheden, til at læse dine laboratorierapporter privat på din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter benötigt Gemini Nano, die geräteinterne KI von Android, um deine Laborbefunde privat auf deinem Gerät zu lesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το LabImporter χρειάζεται το Gemini Nano, την ΤΝ στη συσκευή του Android, για να διαβάζει ιδιωτικά τις εργαστηριακές σας αναφορές στη συσκευή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter necesita Gemini Nano, la IA en el dispositivo de Android, para leer tus informes de laboratorio de forma privada en tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter tarvitsee Gemini Nanon, Androidin laitteella toimivan tekoälyn, lukeakseen laboratorioraporttisi yksityisesti laitteellasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter a besoin de Gemini Nano, l’IA sur l’appareil d’Android, pour lire vos comptes rendus de laboratoire en toute confidentialité sur votre appareil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter treba Gemini Nano, Androidovu umjetnu inteligenciju na uređaju, kako bi privatno čitao vaše laboratorijske nalaze na vašem uređaju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A LabImporternek a Gemini Nanóra, az Android eszközön futó MI-jére van szüksége ahhoz, hogy privát módon, az eszközödön olvassa be a laborleleteidet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter ha bisogno di Gemini Nano, l’IA sul dispositivo di Android, per leggere i tuoi referti di laboratorio in modo privato sul tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporterで検査報告書をデバイス上で非公開のまま読み取るには、Androidのデバイス上AIであるGemini Nanoが必要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter heeft Gemini Nano nodig, de AI op het apparaat van Android, om je laboratoriumrapporten privé op je apparaat te lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter potrzebuje Gemini Nano – sztucznej inteligencji Androida działającej na urządzeniu – aby prywatnie odczytywać wyniki badań na Twoim urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LabImporter precisa do Gemini Nano, a IA no dispositivo do Android, para ler seus laudos laboratoriais de forma privada no seu dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LabImporter precisa do Gemini Nano, a IA no dispositivo do Android, para ler os seus relatórios laboratoriais de forma privada no seu dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter are nevoie de Gemini Nano, IA de pe dispozitiv a Android, ca să-ți citească rapoartele de laborator în mod privat pe dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter нужен Gemini Nano — ИИ Android на устройстве, — чтобы конфиденциально читать ваши лабораторные отчёты прямо на устройстве."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter potrebuje Gemini Nano, AI v zariadení od Androidu, aby mohol súkromne čítať vaše laboratórne správy priamo vo vašom zariadení."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter behöver Gemini Nano, Androids AI på enheten, för att läsa dina labbrapporter privat på din enhet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter'ın laboratuvar raporlarınızı cihazınızda gizli bir şekilde okuyabilmesi için Android'in cihaz üzerindeki yapay zekası Gemini Nano gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter потрібен Gemini Nano — штучний інтелект Android на пристрої, — щоб приватно читати ваші лабораторні звіти просто на пристрої."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter 需要 Android 的设备端 AI——Gemini Nano，才能在你的设备上私密地读取化验报告。"
          }
        }
      }
    },
    "LabImporter needs a newer version of Android's on-device AI. Update your device, then check again." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter се нуждае от по-нова версия на ИИ на устройството в Android. Актуализирайте устройството си и проверете отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El LabImporter necessita una versió més recent de la IA del dispositiu d'Android. Actualitza el dispositiu i torna-ho a comprovar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter potřebuje novější verzi AI na zařízení od Androidu. Aktualizujte zařízení a zkontrolujte to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter skal bruge en nyere version af Androids AI på enheden. Opdater din enhed, og tjek igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LabImporter benötigt eine neuere Version der geräteinternen KI von Android. Aktualisiere dein Gerät und prüfe es dann erneut."
          }
