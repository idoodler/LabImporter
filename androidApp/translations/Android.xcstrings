    "Only the model file is fetched, from %1$@. Nothing about you or your reports is sent — they're read on this phone." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изтегля се само файлът на модела, от %1$@. Не се изпраща нищо за вас или отчетите ви — те се четат на този телефон."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només es baixa el fitxer del model, des de %1$@. No s'envia res sobre tu ni sobre els teus informes: es llegeixen en aquest telèfon."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stahuje se jen soubor modelu, z %1$@. O vás ani o vašich protokolech se nic neodesílá — čtou se v tomto telefonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun modelfilen hentes, fra %1$@. Intet om dig eller dine rapporter sendes – de læses på denne telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geladen wird nur die Modelldatei, von %1$@. Nichts über dich oder deine Berichte wird gesendet – sie werden auf diesem Telefon gelesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γίνεται λήψη μόνο του αρχείου του μοντέλου, από το %1$@. Δεν αποστέλλεται τίποτα για εσάς ή τις αναφορές σας — διαβάζονται σε αυτό το τηλέφωνο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se descarga el archivo del modelo, desde %1$@. No se envía nada sobre ti ni sobre tus informes: se leen en este teléfono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain mallitiedosto haetaan, osoitteesta %1$@. Sinusta tai raporteistasi ei lähetetä mitään – ne luetaan tällä puhelimella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le fichier du modèle est récupéré, depuis %1$@. Rien sur vous ni sur vos rapports n’est envoyé — ils sont lus sur ce téléphone."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preuzima se samo datoteka modela, s %1$@. Ništa o vama ni o vašim izvješćima ne šalje se — čitaju se na ovom telefonu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a modellfájl töltődik le, innen: %1$@. Rólad és a jelentéseidről semmi nem kerül elküldésre – ezen a telefonon olvasódnak be."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene scaricato solo il file del modello, da %1$@. Non viene inviato nulla su di te o sui tuoi referti: vengono letti su questo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取得するのは%1$@からのモデルファイルだけです。あなたやレポートに関する情報は一切送信されず、レポートはこのスマートフォン上で読み取られます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen het modelbestand wordt opgehaald, van %1$@. Er wordt niets over jou of je rapporten verstuurd – ze worden op deze telefoon gelezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobierany jest tylko plik modelu, z %1$@. Nic o Tobie ani o Twoich raportach nie jest wysyłane — są odczytywane na tym telefonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o arquivo do modelo é baixado, de %1$@. Nada sobre você ou seus relatórios é enviado — eles são lidos neste celular."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o ficheiro do modelo é transferido, de %1$@. Nada sobre si ou os seus relatórios é enviado — são lidos neste telemóvel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se descarcă doar fișierul modelului, de pe %1$@. Nu se trimite nimic despre tine sau rapoartele tale — acestea sunt citite pe acest telefon."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скачивается только файл модели — с %1$@. Ничего о вас и ваших отчётах не отправляется: они читаются на этом телефоне."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sťahuje sa len súbor modelu, z %1$@. O vás ani o vašich správach sa nič neodosiela — čítajú sa v tomto telefóne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara modellfilen hämtas, från %1$@. Inget om dig eller dina rapporter skickas – de läses på den här telefonen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca model dosyası %1$@ adresinden alınır. Sizinle veya raporlarınızla ilgili hiçbir şey gönderilmez; raporlar bu telefonda okunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажується лише файл моделі — з %1$@. Нічого про вас чи ваші звіти не надсилається: вони читаються на цьому телефоні."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会从 %1$@ 获取模型文件。不会发送任何关于你或你的报告的信息——报告在此手机上读取。"
          }
        }
