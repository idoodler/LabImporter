    "Filled in for new reports. A different name found in a report is offered as a suggestion." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попълва се за новите отчети. Различно име, открито в отчет, се предлага като предложение."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'emplena als informes nous. Si un informe mostra un altre nom, s'ofereix com a suggeriment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyplní se u nových protokolů. Jiné jméno nalezené v protokolu se nabídne jako návrh."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udfyldes for nye rapporter. Et andet navn i en rapport foreslås i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für neue Berichte eingetragen. Ein anderer Name aus einem Bericht wird als Vorschlag angeboten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμπληρώνεται στις νέες αναφορές. Ένα διαφορετικό όνομα που βρίσκεται σε αναφορά προτείνεται ως εναλλακτική."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rellena en los informes nuevos. Si un informe muestra otro nombre, se ofrece como sugerencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täytetään uusiin raportteihin. Raportista löytyvä eri nimi tarjotaan ehdotuksena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renseigné pour les nouveaux rapports. Un autre nom trouvé dans un rapport est proposé en suggestion."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upisuje se za nova izvješća. Drugo ime pronađeno u izvješću nudi se kao prijedlog."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új jelentéseknél ez kerül kitöltésre. A jelentésben talált eltérő nevet javaslatként kínálja fel az app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserito nei nuovi referti. Un nome diverso trovato in un referto viene proposto come suggerimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいレポートに入力されます。レポートに別の名前がある場合は候補として表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt ingevuld bij nieuwe rapporten. Een andere naam uit een rapport wordt als suggestie aangeboden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisywane w nowych raportach. Inne imię i nazwisko znalezione w raporcie zostanie zaproponowane jako sugestia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preenchido nos novos relatórios. Um nome diferente encontrado em um relatório é oferecido como sugestão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preenchido nos novos relatórios. Um nome diferente encontrado num relatório é apresentado como sugestão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se completează în rapoartele noi. Un alt nume găsit într-un raport este oferit ca sugestie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подставляется в новые отчёты. Другое имя, найденное в отчёте, предлагается как вариант."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyplní sa v nových správach. Iné meno nájdené v správe sa ponúkne ako návrh."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fylls i för nya rapporter. Ett annat namn som hittas i en rapport föreslås."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni raporlara doldurulur. Raporda bulunan farklı bir ad öneri olarak sunulur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підставляється в нові звіти. Інше ім’я, знайдене у звіті, пропонується як варіант."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新报告会自动填入。报告中出现的其他姓名会作为建议提供。"
          }
        }
      }
    },
    "Welcome to" : {
      "comment" : "Gender-neutral Android wording where iOS inflects automatically (^[…](inflect: true)).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te damos la bienvenida a"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti diamo il benvenuto in"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boas-vindas ao"
          }
        }
      }
    },
    "Welcome back, %@" : {
      "comment" : "Gender-neutral Android wording where iOS inflects automatically (^[…](inflect: true)).",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola de nuevo, %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon retour, %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che piacere rivederti, %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que bom ver você de novo, %@"
          }
        }
      }
    },
    "Let each value's most recent reading appear in launcher shortcuts and search. When off, only the value's name is shown — never a reading." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволете най-новата стойност за всеки показател да се показва в преките пътища на стартовия екран и в търсенето. Когато е изключено, се показва само името на показателя — никога стойност."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet que la lectura més recent de cada valor aparegui a les dreceres del launcher i a la cerca. Quan està desactivat, només es mostra el nom del valor, mai una lectura."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechte nejnovější naměřenou hodnotu každého ukazatele zobrazit ve zkratkách spouštěče a ve vyhledávání. Když je vypnuto, zobrazí se jen název ukazatele — nikdy hodnota."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad den seneste måling for hver værdi vises i genveje på startskærmen og i søgning. Når det er slået fra, vises kun værdiens navn — aldrig en måling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass den neuesten Messwert jedes Werts in den Verknüpfungen des Startbildschirms und in der Suche erscheinen. Wenn aus, wird nur der Name des Werts angezeigt – niemals ein Messwert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέψτε την εμφάνιση της πιο πρόσφατης μέτρησης κάθε τιμής στις συντομεύσεις της αρχικής οθόνης και στην αναζήτηση. Όταν είναι ανενεργό, εμφανίζεται μόνο το όνομα της τιμής — ποτέ μια μέτρηση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que la lectura más reciente de cada valor aparezca en los accesos directos del launcher y en la búsqueda. Cuando está desactivado, solo se muestra el nombre del valor, nunca una lectura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salli kunkin arvon viimeisimmän lukeman näkyä aloitusnäytön pikakuvakkeissa ja haussa. Kun pois päältä, näytetään vain arvon nimi — ei koskaan lukemaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez la dernière mesure de chaque valeur apparaître dans les raccourcis de l’écran d’accueil et dans la recherche. Lorsque désactivé, seul le nom de la valeur est affiché, jamais une mesure."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopustite da se najnovije očitanje svake vrijednosti pojavi u prečacima početnog zaslona i u pretraživanju. Kada je isključeno, prikazuje se samo naziv vrijednosti — nikada očitanje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engedélyezze, hogy minden érték legutóbbi mérése megjelenjen a kezdőképernyő parancsikonjaiban és a keresésben. Kikapcsolva csak az érték neve jelenik meg — mérés soha."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti che la misurazione più recente di ogni valore compaia nelle scorciatoie della schermata Home e nella ricerca. Quando è disattivato, viene mostrato solo il nome del valore, mai una misurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各値の最新の測定値をランチャーのショートカットと検索に表示します。オフのときは値の名称のみが表示され、測定値は表示されません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat de meest recente meting van elke waarde verschijnen in snelkoppelingen op het startscherm en in zoeken. Wanneer uit, wordt alleen de naam van de waarde getoond — nooit een meting."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwól, aby najnowszy wynik każdego parametru pojawiał się w skrótach na ekranie głównym i w wyszukiwaniu. Po wyłączeniu pokazywana jest tylko nazwa parametru — nigdy wynik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que a leitura mais recente de cada valor apareça nos atalhos da tela inicial e na busca. Quando desativado, apenas o nome do valor é mostrado — nunca uma leitura."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que a leitura mais recente de cada valor apareça nos atalhos do ecrã principal e na pesquisa. Quando desativado, só é mostrado o nome do valor — nunca uma leitura."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite ca cea mai recentă valoare măsurată pentru fiecare parametru să apară în comenzile rapide de pe ecranul de pornire și în căutare. Când este dezactivat, se afișează doar numele parametrului — niciodată o valoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите показывать последний результат каждого показателя в ярлыках главного экрана и в поиске. Когда выключено, отображается только название показателя — без значения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povoľte, aby sa najnovšia nameraná hodnota každého ukazovateľa zobrazovala v odkazoch na ploche a vo vyhľadávaní. Keď je vypnuté, zobrazuje sa len názov ukazovateľa — nikdy hodnota."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt det senaste värdet för varje mätvärde visas i genvägar på hemskärmen och i sökningen. När det är av visas bara värdets namn — aldrig ett mätvärde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her değerin en son ölçümünün ana ekran kısayollarında ve aramada görünmesine izin verin. Kapalıyken yalnızca değerin adı gösterilir — asla bir ölçüm."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте показувати останній показник кожного значення в ярликах головного екрана та в пошуку. Коли вимкнено, відображається лише назва значення — без показника."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让每项数值的最新读数显示在启动器快捷方式和搜索中。关闭时仅显示数值名称，绝不显示读数。"
          }
        }
      }
    },
    "%1$@ chart: %2$@ from %3$@ to %4$@. Lowest %5$@, highest %6$@, latest %7$@." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Графика за %1$@: %2$@ от %3$@ до %4$@. Най-ниска %5$@, най-висока %6$@, последна %7$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gràfic de %1$@: %2$@ del %3$@ al %4$@. Mínim %5$@, màxim %6$@, últim %7$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graf %1$@: %2$@ od %3$@ do %4$@. Nejnižší %5$@, nejvyšší %6$@, poslední %7$@."
          }
        },
        "da" : {
