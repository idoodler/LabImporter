    "Health Connect medical records need Android 16 or later. Reports are stored privately in LabImporter on this device." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медицинските записи в Health Connect изискват Android 16 или по-нова версия. Отчетите се съхраняват поверително в LabImporter на това устройство."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els registres mèdics de Health Connect requereixen Android 16 o posterior. Els informes es guarden de forma privada al LabImporter en aquest dispositiu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdravotní záznamy Health Connect vyžadují Android 16 nebo novější. Protokoly se ukládají soukromě v LabImporteru v tomto zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helbredsjournaler i Health Connect kræver Android 16 eller nyere. Rapporter gemmes privat i LabImporter på denne enhed."
