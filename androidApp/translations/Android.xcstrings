    "Save every report as one file, for example to move them to another phone." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запазете всички отчети в един файл, например за да ги преместите на друг телефон."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desa tots els informes en un sol fitxer, per exemple per moure'ls a un altre telèfon."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte všechny protokoly do jednoho souboru, například pro přenos do jiného telefonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem alle rapporter som én fil, f.eks. for at flytte dem til en anden telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere alle Berichte in einer Datei, zum Beispiel um sie auf ein anderes Smartphone zu übertragen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε όλες τις αναφορές σε ένα αρχείο, για παράδειγμα για να τις μεταφέρετε σε άλλο τηλέφωνο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda todos los informes en un solo archivo, por ejemplo para pasarlos a otro teléfono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna kaikki raportit yhteen tiedostoon, esimerkiksi siirtääksesi ne toiseen puhelimeen."
