            "value" : "ИИ на устройството не можа да бъде изтеглен. Проверете интернет връзката си и опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut baixar la IA del dispositiu. Comprova la connexió a internet i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI na zařízení se nepodařilo stáhnout. Zkontrolujte připojení k internetu a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI'en på enheden kunne ikke downloades. Tjek din internetforbindelse, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geräteinterne KI konnte nicht geladen werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η λήψη της ΤΝ στη συσκευή. Ελέγξτε τη σύνδεσή σας στο διαδίκτυο και δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo descargar la IA en el dispositivo. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteella toimivaa tekoälyä ei voitu ladata. Tarkista internetyhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de télécharger l’IA sur l’appareil. Vérifiez votre connexion Internet, puis réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umjetnu inteligenciju na uređaju nije moguće preuzeti. Provjerite internetsku vezu i pokušajte ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült letölteni az eszközön futó MI-t. Ellenőrizd az internetkapcsolatot, és próbáld újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scaricare l’IA sul dispositivo. Controlla la connessione a Internet e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイス上のAIをダウンロードできませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De AI op het apparaat kon niet worden gedownload. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się pobrać sztucznej inteligencji na urządzenie. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
