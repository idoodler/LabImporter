          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google дозволяє застосункам використовувати Gemini Nano лише на окремих телефонах, наприклад Pixel 9 і 10, Galaxy S26 і Galaxy Z Fold7. Деякі телефони використовують його лише для власних функцій."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google 只允许应用在部分手机上使用 Gemini Nano，例如 Pixel 9 和 10、Galaxy S26 以及 Galaxy Z Fold7。有些手机只将其用于自家功能。"
          }
