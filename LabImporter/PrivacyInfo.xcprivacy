<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LabImporter's privacy manifest. Nothing leaves the device: no tracking, no
  tracking domains, no collected data (lab values go to Apple Health on this
  device only). The required-reason APIs below are the ones the app binary,
  including the statically linked LabImporterCore (Kotlin) framework, really
  calls; `nm -u` on the built binary lists no others (no disk space, boot time
  or keyboard APIs). Re-check when adding one: see CLAUDE.md, "Privacy note".
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults.standard / @AppStorage: the app's own preferences (no App Group suite). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- contentModificationDate of the app's own executable (BuildInfoCard: when a TestFlight build expires). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
